  idempotencyKey    String?           @unique @map("idempotency_key") @db.Text
  createdBy         String?           @map("created_by") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  facility      Facility    @relation(fields: [facilityId], references: [id])
  cancelledByUser User?     @relation("AppointmentCancelledBy", fields: [cancelledBy], references: [id])
  checkedInByUser User?     @relation("AppointmentCheckedInBy", fields: [checkinBy], references: [id])
  createdByUser   User?     @relation("AppointmentCreatedBy", fields: [createdBy], references: [id])

