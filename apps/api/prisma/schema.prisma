// =============================================================================
// 36. AUDIT_LOGS
// =============================================================================

model AuditLog {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String?      @map("tenant_id") @db.Uuid
  timestamp       DateTime     @default(now()) @db.Timestamptz
  userId          String       @map("user_id") @db.Uuid
  userRole        String       @map("user_role") @db.Text
  patientId       String?      @map("patient_id") @db.Uuid
  actionType      AuditAction  @map("action_type")
  resourceType    String       @map("resource_type") @db.Text
  resourceId      String       @map("resource_id") @db.Text
  ipAddress       String       @map("ip_address") @db.Inet
  userAgent       String?      @map("user_agent") @db.Text
  outcome         AuditOutcome
  failureReason   String?      @map("failure_reason") @db.Text
  breakGlass      Boolean      @default(false) @map("break_glass")
  breakGlassReason String?     @map("break_glass_reason") @db.Text
  metadata        Json         @default("{}") @db.JsonB
  prevHash        String       @map("prev_hash") @db.Text
  hash            String       @unique @db.Text

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  // No updatedAt or deletedAt — append-only table

  @@index([tenantId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([patientId, timestamp(sort: Desc)])
  @@index([actionType, tenantId])
  @@index([breakGlass, tenantId])
  @@map("audit_logs")
}

