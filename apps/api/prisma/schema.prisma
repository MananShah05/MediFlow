// =============================================================================
// CareOS — Prisma Schema
// Database: PostgreSQL 16+
// Conventions: UUID PKs, timestamps UTC, soft delete, tenant_id on all scoped tables
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
