// =============================================================================
// 1. TENANTS
// =============================================================================

model Tenant {
  id                String            @id @default(uuid()) @db.Uuid
  name              String            @db.Text
  slug              String            @unique @db.Text
  type              TenantType
  status            TenantStatus      @default(provisioning)
  tier              TenantTier        @default(starter)
  region            String            @db.Text
  complianceProfile ComplianceProfile @default(dpdp) @map("compliance_profile")
  address           Json?             @db.JsonB
  contactEmail      String            @map("contact_email") @db.Text
  contactPhone      String?           @map("contact_phone") @db.Text
  gstin             String?           @db.Text
  licenseNumber     String?           @map("license_number") @db.Text
  settings          Json              @default("{}") @db.JsonB
  featureFlags      Json              @default("{}") @map("feature_flags") @db.JsonB
  storagePrefix     String            @map("storage_prefix") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz

  // Relations
  organizations     Organization[]
  facilities        Facility[]
  users             User[]
  roles             Role[]
  userRoles         UserRoleAssignment[]
  patients          Patient[]
  patientProfiles   PatientProfile[]
  doctors           Doctor[]
  nurses            Nurse[]
  departments       Department[]
  appointments      Appointment[]
  encounters        Encounter[]
  admissions        Admission[]
  wards             Ward[]
  rooms             Room[]
  beds              Bed[]
  vitals            Vital[]
  diagnoses         Diagnosis[]
  prescriptions     Prescription[]
  prescriptionItems PrescriptionItem[]
  medications       Medication[]
  medicationAdmins  MedicationAdministration[]
  labOrders         LabOrder[]
  labResults        LabResult[]
  nursingTasks      NursingTask[]
  nursingHandoffs   NursingHandoff[]
  notes             Note[]
  files             File[]
  invoices          Invoice[]
  invoiceItems      InvoiceItem[]
  payments          Payment[]
  consents          Consent[]
  consentEvents     ConsentEvent[]
  auditLogs         AuditLog[]
  sessions          Session[]
  devices           Device[]
  loginAttempts     LoginAttempt[]
  notifications     Notification[]
  retentionPolicies RetentionPolicy[]
  supportTickets    SupportTicket[]
  incidentReports   IncidentReport[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

// =============================================================================
// 2. ORGANIZATIONS
// =============================================================================

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.Text
  type      OrgType
  status    String    @default("active") @db.Text
  metadata  Json      @default("{}") @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  facilities Facility[]

  @@index([tenantId])
  @@map("organizations")
}

// =============================================================================
// 3. FACILITIES
// =============================================================================

model Facility {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  orgId     String?   @map("org_id") @db.Uuid
  name      String    @db.Text
  address   Json      @db.JsonB
  phone     String?   @db.Text
  isActive  Boolean   @default(true) @map("is_active")
  metadata  Json      @default("{}") @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [orgId], references: [id])
  departments  Department[]
  appointments Appointment[]
  encounters   Encounter[]
  admissions   Admission[]
  wards        Ward[]

  @@index([tenantId])
  @@map("facilities")
}

// =============================================================================
// 4. USERS
// =============================================================================

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  email             String     @db.Text
  emailVerified     Boolean    @default(false) @map("email_verified")
  phone             String?    @db.Text
  phoneVerified     Boolean    @default(false) @map("phone_verified")
  passwordHash      String?    @map("password_hash") @db.Text
  status            UserStatus @default(active)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaMethod         MfaMethod? @map("mfa_method")
  totpSecret        String?    @map("totp_secret") @db.Text
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz
  lastLoginIp       String?    @map("last_login_ip") @db.Inet
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz
  timezone          String     @default("Asia/Kolkata") @db.Text
  language          String     @default("en") @db.Text
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Reverse relations
  userRoles              UserRoleAssignment[]         @relation("UserRoleUser")
  assignedRoles          UserRoleAssignment[]         @relation("UserRoleAssignedBy")
  rolePermissionsGranted RolePermission[]   @relation("RolePermissionGrantedBy")
  patient                Patient?           @relation("PatientUser")
  patientsCreatedBy      Patient[]          @relation("PatientCreatedBy")
  patientsUpdatedBy      Patient[]          @relation("PatientUpdatedBy")
  patientProfilesUpdated PatientProfile[]   @relation("PatientProfileUpdatedBy")
  doctor                 Doctor?            @relation("DoctorUser")
  doctorsCreatedBy       Doctor[]           @relation("DoctorCreatedBy")
  nurse                  Nurse?             @relation("NurseUser")
  appointmentsCancelled  Appointment[]      @relation("AppointmentCancelledBy")
  appointmentsCheckedIn  Appointment[]      @relation("AppointmentCheckedInBy")
  appointmentsCreated    Appointment[]      @relation("AppointmentCreatedBy")
  encountersCreated      Encounter[]        @relation("EncounterCreatedBy")
  encountersUpdated      Encounter[]        @relation("EncounterUpdatedBy")
  admissionsCreated      Admission[]        @relation("AdmissionCreatedBy")
  admissionsUpdated      Admission[]        @relation("AdmissionUpdatedBy")
  vitalsRecorded         Vital[]            @relation("VitalRecordedBy")
  vitalsAlertAcked       Vital[]            @relation("VitalAlertAcknowledgedBy")
  diagnosesCreated       Diagnosis[]        @relation("DiagnosisCreatedBy")
  prescriptionsCancelled Prescription[]     @relation("PrescriptionCancelledBy")
  medAdminWitness        MedicationAdministration[] @relation("MedAdminWitness")
  labResultsEntered      LabResult[]        @relation("LabResultEnteredBy")
  nursingTasksCreated    NursingTask[]      @relation("NursingTaskCreatedBy")
  nursingTasksEscalated  NursingTask[]      @relation("NursingTaskEscalatedTo")
  notesAuthored          Note[]             @relation("NoteAuthoredBy")
  filesUploaded          File[]             @relation("FileUploadedBy")
  invoicesCreated        Invoice[]          @relation("InvoiceCreatedBy")
  invoicesIssued         Invoice[]          @relation("InvoiceIssuedBy")
  paymentsRecorded       Payment[]          @relation("PaymentRecordedBy")
  consentsConsenting     Consent[]          @relation("ConsentConsentingUser")
  consentsRevoked        Consent[]          @relation("ConsentRevokedBy")
  consentEventsActor     ConsentEvent[]     @relation("ConsentEventActor")
  sessions               Session[]
  devices                Device[]
  loginAttempts          LoginAttempt[]
  notifications          Notification[]
  supportTicketsCreated  SupportTicket[]    @relation("SupportTicketCreatedBy")
  supportTicketsAssigned SupportTicket[]    @relation("SupportTicketAssignedTo")
  incidentReports        IncidentReport[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([phone])
  @@map("users")
}

// =============================================================================
// 5. ROLES
// =============================================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  name        String   @db.Text
  displayName String   @map("display_name") @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]

  @@map("roles")
}

// =============================================================================
// 6. PERMISSIONS
// =============================================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.Text
  resource    String   @db.Text
  action      String   @db.Text
  scope       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
}

// =============================================================================
// 7. ROLE_PERMISSIONS
// =============================================================================

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz
  grantedBy    String?  @map("granted_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedByUser User?   @relation("RolePermissionGrantedBy", fields: [grantedBy], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =============================================================================
// 8. USER_ROLES
// =============================================================================

model UserRoleAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  isPrimary  Boolean   @default(false) @map("is_primary")
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  tenant         Tenant @relation(fields: [tenantId], references: [id])
  user           User   @relation("UserRoleUser", fields: [userId], references: [id])
  role           Role   @relation(fields: [roleId], references: [id])
  assignedByUser User?  @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id])

  @@unique([tenantId, userId, roleId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_roles")
}

// =============================================================================
// 9. PATIENTS
// =============================================================================

model Patient {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  userId           String?          @unique @map("user_id") @db.Uuid
  uhid             String           @db.Text
  abhaId           String?          @map("abha_id") @db.Text
  status           PatientStatus    @default(active)
  registrationDate DateTime         @default(now()) @map("registration_date") @db.Date
  registrationType RegistrationType @default(self) @map("registration_type")
  createdBy        String?          @map("created_by") @db.Uuid
  updatedBy        String?          @map("updated_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  user          User?           @relation("PatientUser", fields: [userId], references: [id])
  createdByUser User?           @relation("PatientCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?           @relation("PatientUpdatedBy", fields: [updatedBy], references: [id])
  profile       PatientProfile?
  appointments  Appointment[]
  encounters    Encounter[]
  admissions    Admission[]
  vitals        Vital[]
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  medicationAdmins MedicationAdministration[]
  labOrders     LabOrder[]
  nursingTasks  NursingTask[]
  notes         Note[]
  files         File[]
  invoices      Invoice[]
  payments      Payment[]
  consents      Consent[]
  consentEvents ConsentEvent[]

  @@unique([tenantId, uhid])
  @@index([tenantId])
  @@index([tenantId, uhid])
  @@index([abhaId])
  @@map("patients")
}

// =============================================================================
// 10. PATIENT_PROFILES
// =============================================================================

model PatientProfile {
  id                      String          @id @default(uuid()) @db.Uuid
  patientId               String          @unique @map("patient_id") @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  fullName                String          @map("full_name") @db.Text
  dateOfBirth             DateTime        @map("date_of_birth") @db.Date
  gender                  Gender
  bloodGroup              BloodGroup?     @map("blood_group")
  mobileNumber            String?         @map("mobile_number") @db.Text
  email                   String?         @db.Text
  address                 Json?           @db.JsonB
  city                    String?         @db.Text
  state                   String?         @db.Text
  pincode                 String?         @db.Text
  country                 String          @default("IN") @db.Text
  nationality             String          @default("Indian") @db.Text
  idType                  IdDocType?      @map("id_type")
  idNumber                String?         @map("id_number") @db.Text
  emergencyContactName    String?         @map("emergency_contact_name") @db.Text
  emergencyContactRelation String?        @map("emergency_contact_relation") @db.Text
  emergencyContactPhone   String?         @map("emergency_contact_phone") @db.Text
  allergies               Json            @default("[]") @db.JsonB
  chronicConditions       Json            @default("[]") @map("chronic_conditions") @db.JsonB
  insuranceProvider       String?         @map("insurance_provider") @db.Text
  insurancePolicyNumber   String?         @map("insurance_policy_number") @db.Text
  insuranceValidity       DateTime?       @map("insurance_validity") @db.Date
  preferredLanguage       String          @default("en") @map("preferred_language") @db.Text
  preferredContact        PreferredContact @default(sms) @map("preferred_contact")
  version                 Int             @default(1)
  updatedBy               String?         @map("updated_by") @db.Uuid
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  patient       Patient @relation(fields: [patientId], references: [id])
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  updatedByUser User?   @relation("PatientProfileUpdatedBy", fields: [updatedBy], references: [id])

  @@index([tenantId])
  @@map("patient_profiles")
}

// =============================================================================
// 11. DOCTORS
// =============================================================================

model Doctor {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  registrationNumber String   @map("registration_number") @db.Text
  registrationBody   String   @map("registration_body") @db.Text
  specialization     String   @db.Text
  departmentId       String?  @map("department_id") @db.Uuid
  qualification      String[] @db.Text
  yearsOfExperience  Int?     @map("years_of_experience")
  isActive           Boolean  @default(true) @map("is_active")
  consultationFee    Decimal? @map("consultation_fee") @db.Decimal(10, 2)
  scheduleConfig     Json     @default("{}") @map("schedule_config") @db.JsonB
  createdBy          String?  @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  user          User        @relation("DoctorUser", fields: [userId], references: [id])
  department    Department? @relation("DoctorDepartment", fields: [departmentId], references: [id])
