// =============================================================================
// 32. INVOICES
// =============================================================================

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  patientId        String        @map("patient_id") @db.Uuid
  encounterId      String?       @map("encounter_id") @db.Uuid
  admissionId      String?       @map("admission_id") @db.Uuid
  invoiceNumber    String        @map("invoice_number") @db.Text
  status           InvoiceStatus @default(draft)
  subtotal         Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason   String?       @map("discount_reason") @db.Text
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  currency         String        @default("INR") @db.Text
  dueDate          DateTime?     @map("due_date") @db.Date
  issuedAt         DateTime?     @map("issued_at") @db.Timestamptz
  issuedBy         String?       @map("issued_by") @db.Uuid
  notes            String?       @db.Text
  createdBy        String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  patient       Patient    @relation(fields: [patientId], references: [id])
  encounter     Encounter? @relation(fields: [encounterId], references: [id])
  admission     Admission? @relation(fields: [admissionId], references: [id])
  issuedByUser  User?      @relation("InvoiceIssuedBy", fields: [issuedBy], references: [id])
  createdByUser User       @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([patientId, tenantId])
  @@index([status, tenantId])
  @@map("invoices")
}

// =============================================================================
// 32b. INVOICE_ITEMS (line items — referenced but not explicit in Schema.md)
