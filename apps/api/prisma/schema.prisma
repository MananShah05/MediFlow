  createdByUser  User   @relation("SupportTicketCreatedBy", fields: [createdBy], references: [id])
  assignedToUser User?  @relation("SupportTicketAssignedTo", fields: [assignedTo], references: [id])

  @@map("support_tickets")
}

// =============================================================================
// 43. INCIDENT_REPORTS
// =============================================================================

model IncidentReport {
  id                            String          @id @default(uuid()) @db.Uuid
  tenantId                      String?         @map("tenant_id") @db.Uuid
  reportedBy                    String          @map("reported_by") @db.Uuid
  incidentType                  IncidentType    @map("incident_type")
  severity                      IncidentSeverity
  status                        IncidentStatus  @default(reported)
  title                         String          @db.Text
  description                   String          @db.Text
  affectedPatients              String[]        @default([]) @map("affected_patients") @db.Uuid
  timeline                      Json            @default("[]") @db.JsonB
  rootCause                     String?         @map("root_cause") @db.Text
  remediation                   String?         @db.Text
  regulatoryNotificationRequired Boolean        @default(false) @map("regulatory_notification_required")
  regulatoryNotifiedAt          DateTime?       @map("regulatory_notified_at") @db.Timestamptz
  reportedAt                    DateTime        @default(now()) @map("reported_at") @db.Timestamptz
  resolvedAt                    DateTime?       @map("resolved_at") @db.Timestamptz
  createdAt                     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant? @relation(fields: [tenantId], references: [id])
  reportedByUser User  @relation(fields: [reportedBy], references: [id])

  @@map("incident_reports")
}
